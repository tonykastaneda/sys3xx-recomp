# Toolchain: clang-cl + lld-link (from LLVM-MinGW's clang, renamed) with the MSVC CRT and
# Windows SDK laid out by xwin (no Visual Studio install needed).
#   T6_TOOLS defaults to %USERPROFILE%/tools
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
if(NOT DEFINED T6_TOOLS)
  file(TO_CMAKE_PATH "$ENV{USERPROFILE}/tools" T6_TOOLS)
endif()
file(TO_CMAKE_PATH "$ENV{USERPROFILE}" _home)
set(XWIN_ROOT "${T6_TOOLS}/xwin/sdk")
set(CMAKE_C_COMPILER   "${T6_TOOLS}/clangcl/bin/clang-cl.exe")
set(CMAKE_CXX_COMPILER "${T6_TOOLS}/clangcl/bin/clang-cl.exe")
set(CMAKE_LINKER       "${T6_TOOLS}/clangcl/bin/lld-link.exe")
set(CMAKE_AR           "${_home}/scoop/apps/mingw-mstorsjo-llvm-msvcrt/current/bin/llvm-lib.exe")
set(CMAKE_RC_COMPILER  "${_home}/scoop/apps/mingw-mstorsjo-llvm-msvcrt/current/bin/llvm-rc.exe")
file(GLOB _rd "${_home}/scoop/apps/mingw-mstorsjo-llvm-msvcrt/current/lib/clang/*")
list(GET _rd 0 _rd)
set(_sr "/winsysroot${XWIN_ROOT} -resource-dir ${_rd} /clang:-march=x86-64-v3")
set(CMAKE_C_FLAGS_INIT   "${_sr}")
set(CMAKE_CXX_FLAGS_INIT "${_sr}")
set(CMAKE_RC_FLAGS_INIT  "/I\"${XWIN_ROOT}/Windows Kits/10/Include/10.0.26100/um\" /I\"${XWIN_ROOT}/Windows Kits/10/Include/10.0.26100/shared\"")
foreach(t EXE SHARED MODULE)
  set(CMAKE_${t}_LINKER_FLAGS_INIT "/winsysroot:${XWIN_ROOT}")
endforeach()
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
