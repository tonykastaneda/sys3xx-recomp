# Tekken 6 (arcade) -- what the tools/ scripts need. Sourced by tools/game.sh.
GAME_EXE=t6
GAME_SELF=GAME_113                     # dev_hdd0/game/SCEEXE000/USRDIR/GAME_113.SELF
CODE_END=0x6639dc                      # end of .text before the import stubs (lifter --code-end)
LIFT_HOOKS="0x0015EB20 0x0015EE78"     # functions patches.cpp replaces natively (USB key)

# SPURS job binaries: "sections" (named .bin_objs.* sections) or "va:size" pairs found at
# run time from the job headers (SPU_DUMP_MISS / sizeBinary).
SPU_JOBS="0x1005e280:0x180 0x1005e400:0x4580 0x10062980:0x4680 0x10067000:0x21380 0x10113880:0x800 \
0x10114080:0x1100 0x10115180:0x600 0x10115780:0x2300 0x10117a80:0x1f00 0x10119980:0x1180 \
0x1011ab00:0x1f00 0x1011ca00:0x1b00 0x1011e500:0x1f80 0x10120480:0x5680 0x10125b00:0x1b00"
SPU_TABLE_ENTRIES=0                    # 1: lift code addresses found in SPU data tables too

# Input script for tools/fightbench.sh (seconds:action[:ms]); see core/usio.cpp.
BENCH_INPUT="40:coin1,45:start1,52:lp1,58:lp1,64:lp1,70:lp1,76:lp1,96:right1:1500,98:lp1,99:lk1,100:rp1,101:rk1,115:lp1,116:lk1,130:rp1,131:rk1"
